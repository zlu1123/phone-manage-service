<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.web.mapper.ContractMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.ruoyi.web.domain.Contract">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="version" property="version" jdbcType="VARCHAR"/>
        <result column="content" property="content" jdbcType="VARCHAR"/>
        <result column="file_path" property="filePath" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="TINYINT"/>
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="create_by" property="createBy" jdbcType="VARCHAR"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <result column="update_by" property="updateBy" jdbcType="VARCHAR"/>
    </resultMap>

    <!-- 基础字段列表 -->
    <sql id="Base_Column_List">
        id, name, version, content, file_path, status, create_time, create_by, update_time, update_by
    </sql>

    <!-- 根据ID查询协议 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        WHERE id = #{id}
    </select>

    <!-- 根据协议名称查询 -->
    <select id="selectByName" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        WHERE name = #{name}
    </select>

    <!-- 根据版本号查询 -->
    <select id="selectByVersion" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        WHERE version = #{version}
    </select>

    <!-- 查询所有协议列表 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        ORDER BY create_time DESC
    </select>

    <!-- 查询生效中的协议列表 -->
    <select id="selectActiveContracts" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        WHERE status = 1
        ORDER BY create_time DESC
    </select>

    <!-- 分页查询协议列表 -->
    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 条件查询协议列表 -->
    <select id="selectByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM contract
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="version != null and version != ''">
                AND version = #{version}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
            <if test="createBy != null and createBy != ''">
                AND create_by LIKE CONCAT('%', #{createBy}, '%')
            </if>
        </where>
        ORDER BY update_time DESC
    </select>

    <!-- 新增协议 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO contract (
            name, version, content, file_path, status, create_time, create_by, update_time, update_by
        ) VALUES (
                     #{name}, #{version}, #{content}, #{filePath}, #{status}, #{createTime},
                     #{createBy}, #{updateTime}, #{updateBy}
                 )
    </insert>

    <!-- 选择性新增协议 -->
    <insert id="insertSelective" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO contract
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">name,</if>
            <if test="version != null and version != ''">version,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="filePath != null and filePath != ''">file_path,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateBy != null and updateBy != ''">update_by,</if>
        </trim>
        <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
            <if test="name != null and name != ''">#{name},</if>
            <if test="version != null and version != ''">#{version},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="filePath != null and filePath != ''">#{filePath},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateBy != null and updateBy != ''">#{updateBy},</if>
        </trim>
    </insert>

    <!-- 根据ID更新协议 -->
    <update id="updateById">
        UPDATE contract
        SET name = #{name},
            version = #{version},
            content = #{content},
            file_path = #{filePath},
            status = #{status},
            update_time = #{updateTime},
            update_by = #{updateBy}
        WHERE id = #{id}
    </update>

    <!-- 选择性更新协议 -->
    <update id="updateSelective">
        UPDATE contract
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="version != null and version != ''">version = #{version},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="filePath != null and filePath != ''">file_path = #{filePath},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 更新协议状态 -->
    <update id="updateStatus">
        UPDATE contract
        SET status = #{status},
            update_time = NOW(),
            update_by = #{updateBy}
        WHERE id = #{id}
    </update>

    <!-- 更新协议状态 -->
    <update id="batchUpdateStatus">
        UPDATE contract
        SET status = 0,
            update_time = NOW(),
            update_by = #{updateBy}
        WHERE id != #{id} and status = 1
    </update>

    <!-- 根据ID删除协议 -->
    <delete id="deleteById">
        DELETE FROM contract WHERE id = #{id}
    </delete>

    <!-- 批量删除协议 -->
    <delete id="deleteBatch">
        DELETE FROM contract
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <!-- 统计协议总数 -->
    <select id="countTotal" resultType="int">
        SELECT COUNT(*) FROM contract
    </select>

    <!-- 检查协议名称是否存在 -->
    <select id="checkNameExists" resultType="int">
        SELECT COUNT(*) FROM contract WHERE name = #{name}
    </select>

    <!-- 检查协议版本是否存在 -->
    <select id="checkVersionExists" resultType="int">
        SELECT COUNT(*) FROM contract WHERE version = #{version}
    </select>

</mapper>